# ==============================================================
# AcademiaSync - Deployment Environment Variables
# ==============================================================

# MongoDB Database Connection
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/academiasync?retryWrites=true&w=majority

# Clerk Authentication (Get from https://dashboard.clerk.com)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=your_clerk_publishable_key_here
CLERK_SECRET_KEY=your_clerk_secret_key_here
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# Google Gemini AI API Key (Get from https://aistudio.google.com)
GEMINI_API_KEY=your_gemini_api_key_here

# Automated Email Notifications (Optional - Gmail App Password or SMTP)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=college.admin@college.edu
EMAIL_PASS=your_app_specific_password

# Geofence & TOTP Configuration (Optional overrides)
GEOFENCE_RADIUS_METERS=50
COLLEGE_LATITUDE=22.5726
COLLEGE_LONGITUDE=88.3639
TOTP_SECRET=ACADEMIA_SYNC_COLLEGE_SECRET_KEY
